---
import ImageWeb from "../components/ImageWeb.astro";
import Layout from "../layouts/Layout.astro";
---

<style>
  /* h2 {
    font-family: "DM Sans", sans-serif;
  } */
  .jakarta {
    font-family: "Plus Jakarta Sans", sans-serif;
  }
  .dm-sans {
    font-family: "DM Sans", sans-serif;
  }
</style>

<Layout title="Dawarehouse | Dewa Portofolio. ">
  <div class="min-h-screen bg-black text-white">
    <nav class="font-bold flex justify-between w-full px-5 pt-2 italic">
      <a href="/" class="text-xl dm-sans">Home</a>
      <a
        target="_blank"
        href="https://www.linkedin.com/in/dwmdwira/"
        class="text-xl hover:underline">Contact</a
      >
    </nav>
    <main class="mt-16 px-5">
      <h1
        data-aos="fade-right"
        data-aos="400"
        class="text-5xl jakarta font-bold"
      >
        Dawarehouse
      </h1>
      <div class="flex flex-col">
        <!-- <a
          data-aos="fade-right"
          data-aos-delay="410"
          target="_blank"
          href="https://dawarehouse-app-next.vercel.app/"
          class="italic text-sm hover:underline jakarta mt-2"
        >
          https://dawarehouse-app-next.vercel.app/
        </a> -->
        <a
          data-aos="fade-right"
          data-aos-delay="420"
          target="_blank"
          href="https://github.com/DewaMadeWira/dawarehouse-app-next"
          class="italic text-sm hover:underline jakarta mt-2 underline text-lg"
        >
          https://github.com/DewaMadeWira/dawarehouse-app-next
        </a>
        <p
          data-aos="fade-right"
          data-aos-delay="500"
          class="mt-5 w-1/2 jakarta text-xl text-justify"
        >
          A modern Inventory Management System built with JavaScript, Prisma
          ORM, and Shadcn/UI for a clean and responsive interface. It integrates
          with a PostgreSQL database to ensure reliable data storage and
          management.
        </p>
        <p
          data-aos="fade-right"
          data-aos-delay="500"
          class="mt-5 w-1/2 jakarta text-2xl font-bold"
        >
          Key Features:
        </p>
      </div>
      <div class="flex flex-col w-full items-center mt-10 gap-4 pt-3">
        <ImageWeb
          image="Home"
          page="Home Page"
          description="A realtime dashboard calculated from the incoming and outgoing item, helping the user to keep track of their inventory."
        />
        <ImageWeb image="About" page="About Page" />
        <ImageWeb image="Warehouse" page="Warehouse Page" />
        <ImageWeb image="Item" page="Item Page" />
        <ImageWeb image="Item Add" page="Add Item Page" />
        <ImageWeb image="Incoming" page="Incoming Page" />
        <ImageWeb image="Incoming Add" page="Add Incoming Page" />
        <ImageWeb image="Outgoing" page="Outgoing Page" />
        <ImageWeb image="Outgoing Add" page="Add Outgoing Page" />
      </div>
    </main>
  </div>
</Layout>
